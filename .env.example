# Variables para docker compose / arranque
# Copia este archivo como .env y llena los valores reales.

# MySQL
MYSQL_ROOT_PASSWORD=<tu-password-root>
DB_USER=<tu-usuario-bd>
DB_PASSWORD=<tu-password-bd>

# JWT
JWT_SECRET=<cadena-larga-aleatoria>
JWT_EXPIRATION=28800000
JWT_ADMIN_PASSWORD=<password-admin-inicial>

# Cloudinary (fotos de alumnos/usuarios)
CLOUDINARY_CLOUD_NAME=<tu-cloud-name>
CLOUDINARY_API_KEY=<tu-api-key>
CLOUDINARY_API_SECRET=<tu-api-secret>

# ngrok (solo deploy)
NGROK_DOMAIN_BACK=<tu-dominio>.ngrok-free.dev
NGROK_AUTHTOKEN_BACK=<tu-authtoken-ngrok>

# Integraciones externas (OPCIONALES; vacías usan simulador)
#API_TOKEN=<token-apiperu>
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_PHONE_NUMBER=

# Mail (JavaMailSender) - Recuperación de contraseña
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<tu-email@gmail.com>
MAIL_PASSWORD=<tu-app-password-de-gmail>
MAIL_FROM=noreply@escolar.edu.pe